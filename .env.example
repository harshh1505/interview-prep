# ============================================================
#  INTERVIEW PREP — ENVIRONMENT VARIABLES TEMPLATE
#  Copy to .env and fill in your real values.
#  This file is safe to commit. Never commit .env itself.
# ============================================================

# BACKEND SERVER
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# GOOGLE GEMINI API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# PINECONE VECTOR DATABASE
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=interview-prep
PINECONE_HOST=https://your-index.svc.pinecone.io

# SUPABASE (Auth + Database)
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FRONTEND (Next.js) — must match SUPABASE_URL / SUPABASE_ANON_KEY above
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Add to Supabase Auth → URL Configuration → Redirect URLs:
#   http://localhost:3000/api/auth/callback
