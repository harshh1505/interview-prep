# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API (Required for Questions, Evaluations, and Embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pinecone Vector Database (Required for Resume Chunking & Vector Retrieval)
PINECONE_API_KEY=
PINECONE_INDEX=interview-prep
PINECONE_HOST=

# Supabase (Optional: if not provided, local store backend/data/store.json is automatically used)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
