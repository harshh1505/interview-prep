# ============================================================
#  INTERVIEW PREP — MASTER ENVIRONMENT FILE
#  Used by both frontend (Next.js) and backend (Express)
#  Copy this file to .env and fill in your values.
#  !! Never commit real secrets to git !!
# ============================================================

# ------------------------------------------------------------
# BACKEND SERVER
# ------------------------------------------------------------
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# GOOGLE GEMINI API  (Required)
# Used by: backend (question generation, answer evaluation, embeddings)
#          frontend API routes (same key re-exported)
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# PINECONE VECTOR DATABASE  (Required)
# Used by: backend (resume chunking & vector retrieval)
#          frontend API routes
# ------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=interview-prep
PINECONE_HOST=https://your-index.svc.pinecone.io

# ------------------------------------------------------------
# SUPABASE  (Required for Auth + DB)
# Used by: frontend (NEXT_PUBLIC_* for browser auth)
#          backend (service role key for server-side DB access)
# Get these from: Supabase Dashboard → Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------
# FRONTEND (Next.js)
# NEXT_PUBLIC_* vars are exposed to the browser bundle.
# The values below are derived from the Supabase keys above —
# keep them in sync.
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Add to Supabase Auth → URL Configuration → Redirect URLs:
#   http://localhost:3000/api/auth/callback